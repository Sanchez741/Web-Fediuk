.year { background: #142850; color: white; border-radius: 20px; padding: 2px 10px; margin-right: 12px; }
.preview { width: 100%; height: auto; border-radius: 6px; display: block; }
footer { text-align: center; padding: 40px 16px; }
footer a { margin: 0 8px; }
@media (max-width: 650px) {
  header { display: flex; justify-content: flex-end; padding: 6px 14px; }
  #toggle { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: white; color: #21243d; font-size: 26px; cursor: pointer; }
  nav { display: none; position: absolute; right: 16px; top: 50px; z-index: 1; min-width: 165px; background: white; box-shadow: 0 5px 18px #21243d26; padding: 8px; }
  #toggle[aria-expanded="true"] + nav { display: grid; gap: 0; }
  nav a { padding: 12px; }
  .intro { flex-direction: column-reverse; align-items: center; text-align: center; gap: 32px; padding: 28px 0 52px; }
  .portrait { width: 175px; height: 175px; }
  h1 { font-size: 32px; }
  h2 { text-align: center; font-size: 18px; }
  .cards, .work { grid-template-columns: 1fr; gap: 16px; }
  .card { padding: 20px; }
  h3 { font-size: 23px; }
}
</style>
