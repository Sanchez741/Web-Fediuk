h2 { font-size: 22px; font-weight: normal; margin: 0 0 16px; }
.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.card { padding: 24px; background: white; border-radius: 4px; }
h3 { font-size: 25px; line-height: 1.25; margin: 0 0 12px; }
article p { margin: 10px 0 0; }
.works { padding: 30px 0; }
